<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aula 14</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CorrecaoExercicios.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="site-nav" aria-label="Navegacao principal">
            <a class="brand-mark" asp-controller="Home" asp-action="Index"><span>14</span> MVC / AULA</a>
            <div class="nav-links">
                <a asp-controller="Home" asp-action="Index">Exercicios</a>
                <a asp-controller="Produto" asp-action="Listar">Produtos</a>
                <a asp-controller="Home" asp-action="Cliente">Cliente</a>
            </div>
        </nav>
    </header>
    <main role="main" class="page-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <span>Desenvolvimento Web I</span>
        <span>ASP.NET Core MVC <span class="footer-dot">&#9679;</span> Aula 14</span>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
