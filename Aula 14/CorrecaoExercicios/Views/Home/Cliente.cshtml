@model Cliente
@{
    ViewData["Title"] = "Dados do cliente";
}

<section class="demo-page">
    <p class="eyebrow">EXERCICIOS 08–10 / MODEL</p>
    <h1>Dados do cliente</h1>
    <p>O Controller envia um objeto <code>Cliente</code> e a View o recebe com <code>@@model Cliente</code>.</p>
    <dl class="detail-list">
        <div><dt>Id</dt><dd>@Model.Id</dd></div>
        <div><dt>Nome</dt><dd>@Model.Nome</dd></div>
        <div><dt>Email</dt><dd><a href="mailto:@Model.Email">@Model.Email</a></dd></div>
    </dl>
    <a class="back-link" asp-action="Index">&larr; Voltar aos exercicios</a>
</section>